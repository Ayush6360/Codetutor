# ── AI provider ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. Defaults to Google's Gemini
# OpenAI-compatible endpoint (free tier).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your_gemini_api_key_here

# Comma-separated fallback chain of models. The provider tries each in order
# and falls through to the next if the current one is rate-limited, down,
# or unavailable. Leave unset to use the built-in defaults (newest free
# Gemini flash models):
#   gemini-3.8-flash, gemini-flash-latest, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-flash-lite-latest
# AI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Back-compat: a single AI_MODEL still works and is prepended to the chain.
# AI_MODEL=gemini-3.8-flash

# Per-model request timeout in ms. Defaults to 20s. On Vercel Hobby (10s
# function cap) set this to 8000 so a single attempt can't exceed the budget.
# AI_TIMEOUT_MS=20000

# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token (only needed to raise rate limits; optional for
# small public repos).
GITHUB_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8787
